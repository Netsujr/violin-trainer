{
  "name": "violin-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "s=0; for f in listen practice library extra race timeline sections language tempo follow flows fullscreen screens; do echo \"== $f\"; node e2e/$f.mjs || s=1; done; exit $s"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "pitchy": "^4.1.0",
    "tonal": "^6.5.1",
    "vexflow": "^5.0.0"
  }
}
